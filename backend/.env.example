# ---------------------------------------------------------------------------
# Human Brain Corporation-RH — variables d'environnement de production.
# Copier vers `.env` sur le serveur et renseigner les vraies valeurs.
# NE JAMAIS committer le fichier .env.
# ---------------------------------------------------------------------------

# Django core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=humanbcorp.com,www.humanbcorp.com
CSRF_TRUSTED_ORIGINS=https://humanbcorp.com,https://www.humanbcorp.com

# PostgreSQL (doit correspondre aux identifiants du service db)
POSTGRES_DB=humanbcorp
POSTGRES_USER=humanbcorp
POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_HOST / POSTGRES_PORT sont fixés par docker-compose (db:5432)

# Image à exécuter. Le nom suit le dépôt GitHub qui build l'image via CI
# (ghcr.io/<owner>/<repo>). Dépôt : EdwinTchakounte/humanbcorp.
WEB_IMAGE=ghcr.io/edwintchakounte/humanbcorp:latest

# Google OAuth (laisser vide pour désactiver le login social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Brevo via django-anymail (refonte 2026).
# En prod, activer le backend Brevo + renseigner la clé API transactionnelle.
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=xkeysib-...
DEFAULT_FROM_EMAIL=HBC-RH <noreply@humanbcorp.com>
CONTACT_NOTIFICATION_EMAIL=recrutementhbcrh@gmail.com
# (Ancien SMTP Gmail — inerte tant que EMAIL_BACKEND n'est pas 'smtp')
EMAIL_HOST_USER=recrutementhbcrh@gmail.com
EMAIL_HOST_PASSWORD=

# Paiement mobile money Tara (encaissement en ligne MTN MoMo / Orange Money).
# Sans TARA_API_KEY/TARA_BUSINESS_ID, le provider passe en mode mock (dev only).
TARA_API_KEY=
TARA_BUSINESS_ID=
TARA_WEBHOOK_SECRET=
# URL publique de l'API — sert à construire le webhook Tara :
#   {PUBLIC_BASE_URL}/api/v1/payments/webhook/tara/
# EN LOCAL avec de vraies clés Tara : Tara ne peut pas joindre localhost pour la
# confirmation. Exposer le backend via un tunnel (ngrok/cloudflared) et mettre son
# URL ici, OU laisser la réconciliation (qcluster) confirmer par polling check_status.
PUBLIC_BASE_URL=https://api.humanbcorp.com
# URL publique de la vitrine (web/) — lien magique de l'espace apprenant dans les e-mails.
SITE_PUBLIC_URL=https://humanbcorp.com
# Modes test — À LAISSER FALSE EN PROD (valident sans Tara / sans contrôle montant).
PAYMENTS_TEST_AUTO_VALIDATE=False
PAYMENTS_TEST_ALLOW_ANY_AMOUNT=False

# Durcissement HTTPS — le TLS est terminé par le nginx central mutualisé,
# qui transmet X-Forwarded-Proto ; ces réglages sont donc sûrs à activer.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

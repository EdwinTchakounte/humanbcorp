# Vitrine HBC-RH — variables d'environnement.
#
# ATTENTION : les variables NEXT_PUBLIC_* sont figées AU MOMENT DU BUILD, pas au
# démarrage. Les renseigner sur le serveur après coup n'a aucun effet : il faut
# rebuilder. Copier ce fichier en `.env.local` pour le développement.

# URL publique du site. Sert de base aux aperçus de partage (og:image, og:url),
# au sitemap et au robots.txt. Une URL locale en production rend les aperçus
# WhatsApp/LinkedIn invisibles — le build échoue volontairement dans ce cas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de l'API Django. Les images de formation sont servies depuis ce domaine :
# elle doit donc être joignable depuis l'extérieur, pas seulement du serveur.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8011

# Durée du cache des pages, en secondes. Le contenu édité dans le dashboard
# réapparaît au bout de ce délai, sans redéploiement.
NEXT_PUBLIC_REVALIDATE=60
